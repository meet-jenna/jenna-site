# Canonical marketing site origin (used for sitemap, canonicals, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://www.meetjenna.ai

# URL of the customer portal (meet-jenna dashboard app).
NEXT_PUBLIC_PORTAL_URL=https://jenna-portal.vercel.app

# Public contact email (schema + contact page). Defaults to mail@meetjenna.ai.
NEXT_PUBLIC_CONTACT_EMAIL=mail@meetjenna.ai

# Optional: Search Console / Bing meta verification tokens (set via Vercel if used).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Optional official profile URLs for footer + Organization sameAs.
NEXT_PUBLIC_SOCIAL_X_URL=
NEXT_PUBLIC_SOCIAL_LINKEDIN_URL=
NEXT_PUBLIC_SOCIAL_GITHUB_URL=
NEXT_PUBLIC_SOCIAL_YOUTUBE_URL=
NEXT_PUBLIC_SOCIAL_PRODUCTHUNT_URL=
NEXT_PUBLIC_SOCIAL_CRUNCHBASE_URL=
NEXT_PUBLIC_TWITTER_SITE=
NEXT_PUBLIC_FOUNDING_DATE=
NEXT_PUBLIC_DEMO_YOUTUBE_ID=

# Resend API key for Book a Demo form emails.
RESEND_API_KEY=
DEMO_TO_EMAIL=mail@meetjenna.ai
DEMO_FROM_EMAIL=Jenna Demo <onboarding@resend.dev>
